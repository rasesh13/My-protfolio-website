{
  "version": 2,
  "buildCommand": "npm install",
  "env": [
    "NODE_ENV",
    "PORT",
    "EMAIL_USER",
    "EMAIL_PASSWORD",
    "MONGODB_URI"
  ],
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    },
    {
      "src": "/health",
      "dest": "server.js"
    }
  ]
}
