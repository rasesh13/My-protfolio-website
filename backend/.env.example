# Backend Environment Variables
# For development: Copy to .env
# For production: Configure in Vercel dashboard

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-portfolio.vercel.app

# MongoDB Configuration
# Using MongoDB Atlas (Cloud)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Local MongoDB (if running locally)
# MONGODB_URI=mongodb://localhost:27017/portfolio

# Email Configuration (Gmail with App Password)
# 1. Enable 2FA on Gmail
# 2. Go to myaccount.google.com > Security > App passwords
# 3. Generate app password for Mail/Windows
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Note: For Gmail, you need to:
# 1. Enable 2-Factor Authentication
# 2. Create an App Password (NOT your regular password)
# 3. Use the App Password in EMAIL_PASSWORD
# Visit: https://myaccount.google.com/apppasswords

# Optional: API Keys for future features
# OPENAI_API_KEY=sk-...
# STRIPE_API_KEY=sk_test_...

